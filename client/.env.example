# ══════════════════════════════════════════════════════════════════════════════
# EnviroHub Client Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════

# Active Communication Mode:
# 'mqtt' (Default - Cloud HiveMQ broker via WebSockets)
# 'http' (Direct Local Wi-Fi HTTP Demo Mode)
VITE_COMM_MODE=mqtt

# Direct Local Wi-Fi ESP32 HTTP Base URL (Used when VITE_COMM_MODE=http)
# Examples:
#   http://192.168.4.1   (ESP32 SoftAP default)
#   http://192.168.1.50  (ESP32 Local Station IP on your router or mobile hotspot)
VITE_ESP32_HTTP_URL=http://192.168.4.1

# Cloud MQTT Broker Configuration (Used when VITE_COMM_MODE=mqtt)
VITE_MQTT_BROKER_URL=wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_TOPIC_PREFIX=iot-hub
